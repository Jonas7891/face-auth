# Usa la IPv4 de tu computador en la red Wi-Fi, no localhost.
# NUNCA apuntes al :8081 de Metro: ahí no hay backend de auth.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
# biometric (defecto, login facial 1 llamada) | legacy (fallback controlado)
EXPO_PUBLIC_AUTH_MODE=biometric
# 1 = guarda refresh_token y auto-refresh ante 401 | 0 = solo access (rollback cliente)
EXPO_PUBLIC_SESSION_V2=1
# 1 = logs [Auth] (defecto en dev) | 0 = silencio total (recomendado en producción)
EXPO_PUBLIC_AUTH_DEBUG=1
