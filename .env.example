MONGO_ROOT_USERNAME=biometric
MONGO_ROOT_PASSWORD=change-me
MONGO_DB=biometric
MONGO_URL=mongodb://biometric:change-me@mongo:27017/?authSource=admin

MATCH_THRESHOLD=0.6
FINGERPRINT_MATCH_THRESHOLD=8
JWT_SECRET=change-me-minimo-32-caracteres-requerido
CORS_ORIGINS=http://localhost:8080
RATE_LIMIT_MAX_ATTEMPTS=20
RATE_LIMIT_WINDOW_SECONDS=60
AUDIT_RETENTION_DAYS=365
# Sesión v2: 1 = login devuelve refresh_token+session_id (reversible con 0)
SESSION_V2_ENABLED=1
JWT_ISSUER=face-auth
JWT_AUDIENCE=face-auth-clients
# Access corto 5-15 min; refresh rotativo 7 días (minutos)
REFRESH_TOKEN_EXPIRE_MINUTES=10080
